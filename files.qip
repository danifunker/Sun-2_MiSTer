# Quartus IP/Source File list for Sun-2 MiSTer core

set_global_assignment -name QIP_FILE sys/sys.qip

# Packages (must be compiled first)
set_global_assignment -name SYSTEMVERILOG_FILE build/inputs/Wish5380/src/wish5380_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE build/inputs/Wish82586/src/wish82586_pkg.sv
